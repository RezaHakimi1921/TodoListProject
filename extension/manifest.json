{
  "manifest_version": 3,
  "name": "TaskOS Work Log",
  "version": "0.3.0",
  "description": "ثبت سریع Work Log از آیکون کروم. زمان‌بندی نوتیف را API انجام می‌دهد.",
  "permissions": ["alarms", "storage", "notifications"],
  "host_permissions": [
    "http://localhost:5088/*",
    "http://127.0.0.1:5088/*"
  ],
  "action": {
    "default_title": "TaskOS Log",
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon.png"
    }
  },
  "icons": {
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}

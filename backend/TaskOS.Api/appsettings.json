{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Sqlite": "Data Source=taskos.db"
  },
  "TaskOS": {
    "AgingDays": 3,
    "SimilarityThreshold": 0.6,
    "WorkLogClusterThreshold": 0.3,
    "FrontendUrl": "http://127.0.0.1:5173"
  }
}

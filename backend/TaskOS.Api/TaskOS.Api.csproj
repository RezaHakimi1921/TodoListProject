<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TaskOS.Api</RootNamespace>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TaskOSServer)' == 'true'">
    <TargetFramework>net8.0</TargetFramework>
    <DefineConstants>$(DefineConstants);TASKOS_SERVER</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TaskOSServer)' != 'true'">
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.8" />
    <PackageReference Include="WebPush" Version="1.0.12" />
  </ItemGroup>

  <ItemGroup Condition="'$(TaskOSServer)' != 'true'">
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  </ItemGroup>

  <ItemGroup Condition="'$(TaskOSServer)' == 'true'">
    <Compile Remove="Services\WorkPingForm.cs" />
    <Compile Remove="Services\DoneCommentForm.cs" />
    <Compile Remove="Services\SwitchAskForm.cs" />
    <Compile Remove="Services\WindowsToast.cs" />
    <Compile Remove="Services\StartupInstaller.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TaskOSServer)' != 'true'">
    <Compile Remove="Services\ServerUiStubs.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Data\schema.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
